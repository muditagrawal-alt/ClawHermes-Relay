# =============================================================================
# OpenClaw + Hermes Agent Slack Collaboration Environment Variables
# Copy this file to .env and fill in real values (never commit .env to git)
# =============================================================================

# --- Slack App 1: OpenClaw (Orchestrator / Team Lead) ---
OPENCLAW_SLACK_BOT_TOKEN=xoxb-replace-me
OPENCLAW_SLACK_APP_TOKEN=xapp-replace-me

# --- Slack App 2: Hermes Agent (Deep SEO/AEO Researcher) ---
HERMES_SLACK_BOT_TOKEN=xoxb-replace-me
HERMES_SLACK_APP_TOKEN=xapp-replace-me

# --- Shared Slack Channel & Access ---
# Channel ID where both bots are invited (e.g., C0123456789)
SLACK_COLLAB_CHANNEL_ID=C0123456789
# Optional: comma-separated human Slack Member IDs allowed to invoke bots (e.g., U0123456789)
SLACK_HUMAN_USER_IDS=

# --- LLM Provider (choose one or use local Ollama) ---
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# If using local Ollama, leave cloud keys empty and start `ollama serve`

# --- Optional Search API Key (Hermes can also use free DuckDuckGo ddgs) ---
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# FIRECRAWL_API_KEY=

# --- Arize Phoenix Observability ---
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
PHOENIX_PROJECT_NAME=claw-hermes-relay
